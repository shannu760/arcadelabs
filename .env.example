# Copy to .env and fill in. Never commit .env.

# Layer 2 — cloud inference (OpenRouter, OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: monthly spend ceiling enforced by the orchestrator (USD)
AI_MONTHLY_BUDGET_USD=5

# Layer 1 — local inference (Ollama or llama.cpp OpenAI-compatible server)
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=

# Accounts — Supabase Auth. Both values are public (the anon key ships in the
# browser in every Supabase app); they are kept server-side here so the browser
# only ever holds a session token. No service-role key is used by the app.
# With these unset the API runs in loopback-only dev identity mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Database (Layer: PostgreSQL). Enable pgvector extension for AI memory search.
DATABASE_URL=
