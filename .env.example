# Student Icon — every environment variable this project reads.
# Copy what you need into .env (never commit it), or set them in your host.
# Anything left empty behaves as if it were unset.

# ---------------------------------------------------------------- accounts
# Supabase Auth. The URL and anon key are public values (they ship in every
# Supabase browser app); they live server-side here only so the browser never
# holds them. No service-role key is used anywhere in this project.
# With these unset the API falls back to a loopback-only dev identity.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- database
# Hosted Postgres (Supabase: Connect -> Connection string -> URI, session
# pooler). This is a secret: it contains the database password, so it belongs
# in your host's environment and never in the repository.
#
# When set, the API uses this server instead of the embedded database.
# When unset, local development uses the embedded file below, and a deployment
# answers 503 db_not_configured.
# DATABASE_URL is accepted as an alias.
SUPABASE_DB_URL=

# ------------------------------------------------------------ local server
# Port for `node server.mjs` (default 8080).
PORT=8080

# Where the embedded database lives (default .data/icon.db).
# ICON_DB_PATH=:memory: keeps it in RAM; the test suites do this.
# ICON_DB_PATH=

# -------------------------------------------------------- AI (later stages)
# Not read by the current build; the adapters use these when stage 2 lands.
# Layer 2 — cloud inference (OpenRouter, OpenAI-compatible).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional monthly spend ceiling enforced by the orchestrator (USD).
AI_MONTHLY_BUDGET_USD=5

# Layer 1 — local inference (Ollama or llama.cpp OpenAI-compatible server).
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=
