# Student Icon — every environment variable this project reads.
# Copy what you need into .env (never commit it), or set them in your host.
# Anything left empty behaves as if it were unset.

# ---------------------------------------------------------------- accounts
# Supabase Auth. The URL and the publishable key are public values (they ship
# in every Supabase browser app); they live server-side here only so the browser
# never holds them.
# Supabase renamed the anon key: sb_publishable_... is the current form and
# SUPABASE_PUBLISHABLE_KEY the current name. Either spelling is accepted.
# With neither set, the API falls back to a loopback-only dev identity.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=

# The secret / service-role key (sb_secret_...) is only read by account deletion,
# to remove the Supabase Auth user after its player data is gone. Leave it unset
# and deletion still removes all player data, but the email account itself has
# to be removed by hand. Nothing else in this API uses it, and it must never
# reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- database
# Hosted Postgres (Supabase: Connect -> Connection string -> URI, session
# pooler). This is a secret: it contains the database password, so it belongs
# in your host's environment and never in the repository.
#
# When set, the API uses this server instead of the embedded database.
# When unset, local development uses the embedded file below, and a deployment
# answers 503 db_not_configured. DATABASE_URL is accepted as an alias.
SUPABASE_DB_URL=

# ------------------------------------------------------------ protection
# Cloudflare Turnstile on sign-up. Both values come from the Turnstile widget in
# the Cloudflare dashboard; the site key is public, the secret is not. With both
# set, a sign-up without a valid token is refused. With either unset, there is
# no human check (shared throttling and reserved handles still apply).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry, optional. The DSN is read server-side only; failures are also written
# as one JSON log line per error, which every host already collects.
SENTRY_DSN=

# The public origin, used in the sitemap, canonical links and emails.
# Defaults to https://arcadelabs-eight.vercel.app
SITE_URL=

# ------------------------------------------------------------ local server
# Port for `node server.mjs` (default 8080).
PORT=8080

# Where the embedded database lives (default .data/icon.db).
# ICON_DB_PATH=:memory: keeps it in RAM; the test suites do this.
# ICON_DB_PATH=

# -------------------------------------------------------- AI (later stages)
# Not read by the current build; the adapters use these when stage 2 lands.
# Layer 2 — cloud inference (OpenRouter, OpenAI-compatible).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional monthly spend ceiling enforced by the orchestrator (USD).
AI_MONTHLY_BUDGET_USD=5

# Layer 1 — local inference (Ollama or llama.cpp OpenAI-compatible server).
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=
