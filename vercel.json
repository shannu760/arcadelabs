{
  "outputDirectory": "public",
  "functions": {
    "api/*.mjs": {
      "includeFiles": "supabase/migrations/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/api", "destination": "/api/index" },
    { "source": "/:handle([a-z0-9_]{3,20})", "destination": "/profile.html" }
  ]
}
